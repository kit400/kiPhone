<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sim_color_holder"
    style="@style/SettingsHolderTextViewOneLinerStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/sim_color_label"
        style="@style/SettingsTextLabelStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/sim_color_swatch"
        tools:text="SIM 1 - Vodafone" />

    <ImageView
        android:id="@+id/sim_color_swatch"
        android:layout_width="@dimen/sim_color_swatch_size"
        android:layout_height="@dimen/sim_color_swatch_size"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:importantForAccessibility="no" />

</RelativeLayout>
